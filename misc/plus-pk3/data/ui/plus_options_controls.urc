//
// OpenMOHAA Plus options, Controls tab: the game's key list (FakkBindList reading the game's
// ui/bind.scr, anchored in the panel with a fixed height) above four mouse rows. Defaults runs what
// the original controls screen runs. Same frame, bar and panel as the other tabs (see
// plus_options_video.urc).

menu "plus_options_controls" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/opt_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/opt_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (replacemenu), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_detail"
}

resource
Button
{
name "tab_audio"
rect 0 0 170 26
title "Audio"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 142 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_audio"
}

resource
Button
{
name "tab_controls"
rect 0 0 170 26
title "Controls"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_controls"
}

resource
Button
{
name "tab_game"
rect 0 0 170 26
title "Game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 194 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_game"
}

resource
Button
{
name "tab_plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 220 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options"
}

// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "defaults"
rect 0 0 170 26
title "Defaults"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 294 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_resetcvars;exec default.cfg"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

// the key list: fixed height, a whole number of 16-unit rows (header + 8), so the rows below it
// fit every screen and no key row is cut at the bottom
resource
FakkBindList
{
name "bindlist"
rect 0 0 64 144
fgcolor 0 0 0 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 40 -1
filename ui/bind.scr
}

resource
Label
{
name "Sensitivity label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 268 -1 -1
textalign left
title "Sensitivity"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "sensitivity slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 270 -1 -1
font facfont-20
showvalue "%.0f"
linkcvar "sensitivity"
slidertype float
setrange 1 20
stepsize 1
}

resource
Label
{
name "Invert mouse label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 300 -1 -1
textalign left
title "Invert mouse"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "m_invert_pitch checkbox"
rect 0 0 24 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 300 -1 -1
linkcvar "m_invert_pitch"
checked_shader "textures/menu_plus/checkbox_on"
unchecked_shader "textures/menu_plus/checkbox_off"
}

resource
Label
{
name "Mouse filter label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 332 -1 -1
textalign left
title "Mouse filter"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "m_filter checkbox"
rect 0 0 24 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 332 -1 -1
linkcvar "m_filter"
checked_shader "textures/menu_plus/checkbox_on"
unchecked_shader "textures/menu_plus/checkbox_off"
}

resource
Label
{
name "Always run label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 364 -1 -1
textalign left
title "Always run"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "cl_run checkbox"
rect 0 0 24 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 364 -1 -1
linkcvar "cl_run"
checked_shader "textures/menu_plus/checkbox_on"
unchecked_shader "textures/menu_plus/checkbox_off"
}

end.
