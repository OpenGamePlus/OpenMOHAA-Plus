//
// OpenMOHAA Plus options, Plus tab: the fork's own settings. Same frame, bar and panel as the other
// tabs (see plus_options_video.urc). The renderer change takes effect with Apply (ui_applylatched).
// Rows 32 units apart: label at 232, control from 356 to 504 (a pulldown, which shows the chosen
// item before its arrow with "linkcvar", to 516), inside the panel on the narrowest screen (5:4 at
// ui_plusscale 1.1, right edge at 525).

menu "plus_options" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (replacemenu), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_detail"
}

resource
Button
{
name "tab_audio"
rect 0 0 170 26
title "Audio"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 142 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_audio"
}

resource
Button
{
name "tab_controls"
rect 0 0 170 26
title "Controls"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_controls"
}

resource
Button
{
name "tab_game"
rect 0 0 170 26
title "Game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 194 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_game"
}

resource
Button
{
name "tab_plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 220 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options"
}

// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

resource
Label
{
name "Renderer label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 -1 -1
textalign left
title "Renderer"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "cl_renderer list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 112 -1 -1
linkcvar "cl_renderer"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "OpenGL" command "set cl_renderer opengl1"
addpopup "MENU" "Vulkan" command "set cl_renderer vulkan"
}

resource
Label
{
name "HUD scale label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 144 -1 -1
textalign left
title "HUD scale"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "ui_hudscale slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 146 -1 -1
font facfont-20
showvalue "%.1fx"
linkcvar "ui_hudscale"
slidertype float
setrange 0.5 4
stepsize 0.1
}

resource
Label
{
name "Menus keep 4:3 label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 176 -1 -1
textalign left
title "Menus keep 4:3"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "ui_menuaspect checkbox"
rect 0 0 24 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 176 -1 -1
linkcvar "ui_menuaspect"
checked_shader "textures/menu_plus/checkbox_on"
unchecked_shader "textures/menu_plus/checkbox_off"
}

resource
Label
{
name "Crosshair size label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 208 -1 -1
textalign left
title "Crosshair size"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "cg_crosshair_size slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 210 -1 -1
font facfont-20
showvalue "%.1f"
linkcvar "cg_crosshair_size"
slidertype float
setrange 0 4
stepsize 0.1
}

resource
Label
{
name "Crosshair scale label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 240 -1 -1
textalign left
title "Crosshair scale"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "cg_crosshair_scale slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 242 -1 -1
font facfont-20
showvalue "%.1f"
linkcvar "cg_crosshair_scale"
slidertype float
setrange 0.1 4
stepsize 0.1
}

resource
Label
{
name "Language label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 272 -1 -1
textalign left
title "Language"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "cl_language list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 272 -1 -1
linkcvar "cl_language"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "Game default" command "reset cl_language"
addpopup "MENU" "Spanish" command "set cl_language es"
}

resource
Label
{
name "Plus menu size label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 304 -1 -1
textalign left
title "Plus menu size"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "ui_plusscale slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 306 -1 -1
font facfont-20
showvalue "%.0f%%" 100
linkcvar "ui_plusscale"
slidertype float
setrange 0.85 1.1
stepsize 0.05
}

// two lines: one would not fit the narrowest panel
resource
Label
{
name "language note"
rect 0 0 272 20
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 344 -1 -1
textalign left
title "Language: needs lang/<code> files;"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Label
{
name "language note 2"
rect 0 0 272 20
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 364 -1 -1
textalign left
title "restart the game after a change."
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

end.
