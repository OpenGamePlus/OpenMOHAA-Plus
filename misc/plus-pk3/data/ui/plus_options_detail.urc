addpopup "MENU" "Minimum" command "set cg_effectdetail 0.2; set vss_maxcount 25"
addpopup "MENU" "Lower" command "set cg_effectdetail 0.3; set vss_maxcount 23"
addpopup "MENU" "Low" command "set cg_effectdetail 0.5; set vss_maxcount 22"
addpopup "MENU" "Medium" command "set cg_effectdetail 0.7; set vss_maxcount 20"
addpopup "MENU" "High" command "set cg_effectdetail 0.8; set vss_maxcount 18"
addpopup "MENU" "Higher" command "set cg_effectdetail 0.95; set vss_maxcount 15"
addpopup "MENU" "Max" command "set cg_effectdetail 1.0; set vss_maxcount 10"
}

