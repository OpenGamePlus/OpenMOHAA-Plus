fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "ter_error list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 140 -1 -1
linkcvar "ter_error"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "Low" command "set ter_error 10; set ter_maxlod 3; set ter_maxtris 16384"
addpopup "MENU" "Medium" command "set ter_error 9; set ter_maxlod 4; set ter_maxtris 16384"
addpopup "MENU" "High" command "set ter_error 7; set ter_maxlod 5; set ter_maxtris 16384"
addpopup "MENU" "Max" command "set ter_error 4; set ter_maxlod 6; set ter_maxtris 24576"
}

