// OpenMOHAA Plus options, Detail tab: the original game's detail settings and presets (each preset
// sets several cvars; the pulldown shows it when every one matches). Same frame, bar and panel as
// the other tabs (see plus_options_video.urc); rows 28 units apart (10 rows fit the narrowest panel).

menu "plus_options_detail" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/opt_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/opt_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (replacemenu), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_detail"
}

