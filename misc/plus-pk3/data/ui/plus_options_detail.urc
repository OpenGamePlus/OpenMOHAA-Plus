// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

resource
Label
{
name "Models label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 -1 -1
textalign left
title "Models"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "r_lodscale list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 112 -1 -1
linkcvar "r_lodscale"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "Lowest" command "set r_lodscale 0.25; set r_lodcap 0.25; set r_lodviewmodelcap 0.25"
addpopup "MENU" "Low" command "set r_lodscale 0.35; set r_lodcap 0.35; set r_lodviewmodelcap 0.25"
addpopup "MENU" "Medium" command "set r_lodscale 0.45; set r_lodcap 0.35; set r_lodviewmodelcap 0.45"
addpopup "MENU" "High" command "set r_lodscale 0.55; set r_lodcap 0.5; set r_lodviewmodelcap 0.55"
addpopup "MENU" "Higher" command "set r_lodscale 0.9; set r_lodcap 0.9; set r_lodviewmodelcap 0.9"
addpopup "MENU" "Highest" command "set r_lodscale 1.1; set r_lodcap 1.0; set r_lodviewmodelcap 1.0"
}

resource
Label
{
name "Terrain label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 140 -1 -1
textalign left
title "Terrain"
