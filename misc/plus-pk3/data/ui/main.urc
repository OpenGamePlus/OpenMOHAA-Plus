}

resource
Button
{
name "savegame"
rect 0 0 170 26
title "Save game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 100
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "pushmenu_sp loadsave;pushmenu_dm loadsave_mp"
}

resource
Button
{
name "disconnect"
rect 0 0 170 26
title "Disconnect"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 74
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
