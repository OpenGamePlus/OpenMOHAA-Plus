// shown in a game this client runs

resource
Button
{
name "savegame"
rect 0 344 200 28
title "Save game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
hovershader "textures/menu_plus/hover"
