resource
Button
{
name "plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
