}

resource
Button
{
name "disconnect"
rect 0 372 200 28
title "Disconnect"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
