//
// OpenMOHAA Plus options, Audio tab: only cvars the OpenAL sound code uses. Volume, music and
// ambience (s_ambientvolume, the ambient music tracks) apply at once; quality (s_khz) takes effect
// with Apply (ui_applylatched restarts sound when it changed since the options opened) and Back puts
// it back; speakers (s_speaker_type) reopen the OpenAL output at once. Same frame,
// bar and panel as the other tabs (see plus_options_video.urc).

menu "plus_options_audio" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (replacemenu), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_detail"
}

resource
Button
{
name "tab_audio"
rect 0 0 170 26
title "Audio"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 142 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_audio"
}

resource
Button
{
name "tab_controls"
rect 0 0 170 26
title "Controls"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_controls"
}

resource
Button
{
name "tab_game"
rect 0 0 170 26
title "Game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 194 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_game"
}

resource
Button
{
name "tab_plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 220 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options"
}

// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

resource
Label
{
name "Volume label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 -1 -1
textalign left
title "Volume"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "s_volume slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 114 -1 -1
font facfont-20
showvalue "%.0f%%" 100
linkcvar "s_volume"
slidertype float
setrange 0 1
stepsize 0.05
}

resource
Label
{
name "Music label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 144 -1 -1
textalign left
title "Music"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "s_musicvolume slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 146 -1 -1
font facfont-20
showvalue "%.0f%%" 100
linkcvar "s_musicvolume"
slidertype float
setrange 0 1
stepsize 0.05
}

resource
Label
{
name "Ambience label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 176 -1 -1
textalign left
title "Ambience"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "s_ambientvolume slider"
rect 0 0 160 20
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 178 -1 -1
font facfont-20
showvalue "%.0f%%" 100
linkcvar "s_ambientvolume"
slidertype float
setrange 0 1
stepsize 0.05
}

resource
Label
{
name "Quality label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 208 -1 -1
textalign left
title "Quality"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "s_khz list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 208 -1 -1
linkcvar "s_khz"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "Low" command "set s_khz 11"
addpopup "MENU" "Medium" command "set s_khz 22"
addpopup "MENU" "High" command "set s_khz 44"
}

resource
Label
{
name "Speakers label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 240 -1 -1
textalign left
title "Speakers"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "s_speaker_type list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 240 -1 -1
linkcvar "s_speaker_type"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "Two speakers" command "set s_speaker_type 0"
addpopup "MENU" "Headphones" command "set s_speaker_type 1"
addpopup "MENU" "Surround" command "set s_speaker_type 2"
addpopup "MENU" "Quad" command "set s_speaker_type 3"
}

end.
