//
// OpenMOHAA Plus options, Game tab. Field of view is cg_fov (client side, kept between 65 and 120
// by cgame; zoom and cameras use the server's). Same frame, bar and panel as the other tabs (see
// plus_options_video.urc).

menu "plus_options_game" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (replacemenu), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_detail"
}

resource
Button
{
name "tab_audio"
rect 0 0 170 26
title "Audio"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 142 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_audio"
}

resource
Button
{
name "tab_controls"
rect 0 0 170 26
title "Controls"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_controls"
}

resource
Button
{
name "tab_game"
rect 0 0 170 26
title "Game"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 194 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options_game"
}

resource
Button
{
name "tab_plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 220 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "replacemenu plus_options"
}

// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

resource
Label
{
name "Field of view label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 -1 -1
textalign left
title "Field of view"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "cg_fov slider"
rect 0 0 148 16
fgcolor 1 1 1 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 116 -1 -1
shader "textures/menu/slider"
linkcvar "cg_fov"
slidertype float
setrange 80 120
stepsize 1
}

resource
Label
{
name "Weapon model label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 144 -1 -1
textalign left
title "Weapon model"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "cg_drawviewmodel list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 144 -1 -1
linkcvar "cg_drawviewmodel"
font facfont-20
shader "textures/menu_plus/field"
menushader "MENU" "textures/menu_plus/clear"
selmenushader "MENU" "textures/menu_plus/clear"
addpopup "MENU" "None" command "set cg_drawviewmodel 0"
addpopup "MENU" "Gun only" command "set cg_drawviewmodel 1"
addpopup "MENU" "Full" command "set cg_drawviewmodel 2"
}

resource
Label
{
name "Weather label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 176 -1 -1
textalign left
title "Weather"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "cg_rain checkbox"
rect 0 0 24 24
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 176 -1 -1
linkcvar "cg_rain"
checked_shader "textures/menu/checkbox_checked"
unchecked_shader "textures/menu/checkbox_unchecked"
}

resource
Label
{
name "Subtitles label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 208 -1 -1
textalign left
title "Subtitles"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "g_subtitle checkbox"
rect 0 0 24 24
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 208 -1 -1
linkcvar "g_subtitle"
checked_shader "textures/menu/checkbox_checked"
unchecked_shader "textures/menu/checkbox_unchecked"
}

resource
Label
{
name "Console label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 240 -1 -1
textalign left
title "Console"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
