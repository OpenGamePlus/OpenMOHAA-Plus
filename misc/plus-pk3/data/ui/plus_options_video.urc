//
// OpenMOHAA Plus options, Video tab. Same frame, background, bar and panel on every tab (see
// main.urc for the units; every widget has "anchor"). Rows 32 units apart from y=112: label at
// 232, control at 356; a pulldown with "linkcvar" shows the chosen item (an item matches when every
// "set" in it matches). Resolutions use r_mode -1 with r_customwidth/height; Desktop is r_mode -2.
// Latched settings apply with Apply (ui_applylatched).

menu "plus_options_video" 2048 480 NONE 0
bgcolor 0 0 0 0
borderstyle NONE
bgfill 0 0 0 1
fullscreen 1
virtualres 1
scalecvar ui_plusscale

resource
Label
{
name "background left"
rect 0 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_l"
}

resource
Label
{
name "background right"
rect 576 0 576 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
cover 1152 480
shader "textures/menu_plus/bg_r"
}

resource
Label
{
name "bar"
rect 0 0 300 480
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
align left
stretch vertical
shader "textures/menu_plus/bar"
}

resource
Label
{
name "title"
rect 0 0 170 32
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 30 -1 -1
textalign left
title "Options"
font facfont-20
fgcolor 0.94 0.75 0.38 1
}

// tabs replace each other (popmenu 0), so Back always returns to the main menu
resource
Button
{
name "tab_video"
rect 0 0 170 26
title "Video"
font facfont-20
fgcolor 0.94 0.75 0.38 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 90 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options_video"
}

resource
Button
{
name "tab_detail"
rect 0 0 170 26
title "Detail"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 116 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options_detail"
}

resource
Button
{
name "tab_audio"
rect 0 0 170 26
title "Audio"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 142 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options_audio"
}

resource
Button
{
name "tab_controls"
rect 0 0 170 26
title "Controls"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 168 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options_controls"
}

resource
Button
{
name "tab_game"
rect 0 0 170 26
title "Game"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 194 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options_game"
}

resource
Button
{
name "tab_plus"
rect 0 0 170 26
title "Plus"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 220 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/scroll.wav"
stuffcommand "popmenu 0;pushmenu plus_options"
}

// Apply restarts what pending changes need, from any tab; Back drops unapplied ones
resource
Button
{
name "apply"
rect 0 0 170 26
title "Apply"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 268 -1 -1
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/apply.wav"
stuffcommand "ui_applylatched;popmenu 0"
}

resource
Button
{
name "back"
rect 0 0 170 26
title "Back"
font facfont-20
fgcolor 0.93 0.89 0.80 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 30 -1 -1 40
textalign left
hovershader "textures/menu_plus/hover"
clicksound "sound/menu/back.wav"
stuffcommand "ui_discardlatched;popmenu 0"
}

// dark content panel, 20 units from the right edge
resource
Label
{
name "panel"
rect 0 0 64 64
bgcolor 0.02 0.04 0.02 0.8
borderstyle "NONE"
scalecvar ui_plusscale
anchor 220 100 20 40
}

resource
Label
{
name "Resolution label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 112 -1 -1
textalign left
title "Resolution"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "r_mode list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 112 -1 -1
linkcvar "r_mode"
font facfont-20
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "Desktop" command "set r_mode -2"
addpopup "MENU" "1280x720" command "set r_mode -1; set r_customwidth 1280; set r_customheight 720"
addpopup "MENU" "1600x900" command "set r_mode -1; set r_customwidth 1600; set r_customheight 900"
addpopup "MENU" "1920x1080" command "set r_mode -1; set r_customwidth 1920; set r_customheight 1080"
addpopup "MENU" "2560x1440" command "set r_mode -1; set r_customwidth 2560; set r_customheight 1440"
addpopup "MENU" "3840x2160" command "set r_mode -1; set r_customwidth 3840; set r_customheight 2160"
addpopup "MENU" "2560x1080" command "set r_mode -1; set r_customwidth 2560; set r_customheight 1080"
addpopup "MENU" "3440x1440" command "set r_mode -1; set r_customwidth 3440; set r_customheight 1440"
addpopup "MENU" "1024x768" command "set r_mode -1; set r_customwidth 1024; set r_customheight 768"
addpopup "MENU" "1280x1024" command "set r_mode -1; set r_customwidth 1280; set r_customheight 1024"
}

resource
Label
{
name "Display label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 144 -1 -1
textalign left
title "Display"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "r_fullscreen list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 144 -1 -1
linkcvar "r_fullscreen"
font facfont-20
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "Fullscreen" command "set r_fullscreen 1; set r_noborder 0"
addpopup "MENU" "Window" command "set r_fullscreen 0; set r_noborder 0"
addpopup "MENU" "Borderless" command "set r_fullscreen 0; set r_noborder 1"
}

resource
Label
{
name "Vsync label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 176 -1 -1
textalign left
title "Vsync"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
CheckBox
{
name "r_swapInterval checkbox"
rect 0 0 24 24
fgcolor 1 1 1 1
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 176 -1 -1
linkcvar "r_swapInterval"
checked_shader "textures/menu/checkbox_checked"
unchecked_shader "textures/menu/checkbox_unchecked"
}

resource
Label
{
name "Max FPS label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 208 -1 -1
textalign left
title "Max FPS"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
PulldownMenuContainer
{
title "Choose..."
name "com_maxfps list"
rect 0 0 160 24
fgcolor 0.94 0.75 0.38 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 208 -1 -1
linkcvar "com_maxfps"
font facfont-20
menushader "MENU" "textures/menu/pulldownarrow"
selmenushader "MENU" "textures/menu/pulldownarrow_sel"
addpopup "MENU" "60" command "set com_maxfps 60"
addpopup "MENU" "85" command "set com_maxfps 85"
addpopup "MENU" "120" command "set com_maxfps 120"
addpopup "MENU" "144" command "set com_maxfps 144"
addpopup "MENU" "165" command "set com_maxfps 165"
addpopup "MENU" "240" command "set com_maxfps 240"
addpopup "MENU" "333" command "set com_maxfps 333"
}

resource
Label
{
name "Brightness label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 240 -1 -1
textalign left
title "Brightness"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

resource
Slider
{
name "r_gamma slider"
rect 0 0 148 16
fgcolor 1 1 1 1
bgcolor 0.5 0.5 0.5 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 356 244 -1 -1
shader "textures/menu/slider"
linkcvar "r_gamma"
slidertype float
setrange 0.5 3
stepsize 0.1
}

resource
Label
{
name "Textures label"
rect 0 0 120 24
bgcolor 0 0 0 0
borderstyle "NONE"
scalecvar ui_plusscale
anchor 232 272 -1 -1
textalign left
title "Textures"
font facfont-20
fgcolor 0.93 0.89 0.80 1
}

