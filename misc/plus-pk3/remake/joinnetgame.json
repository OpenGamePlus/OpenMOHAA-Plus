{
 "menu": "joinnetgame",
 "screen": true,
 "camera": "Cam_ServerList",
 "controls": [
  {
   "name": "netgamelist",
   "kind": "servers",
   "class": "FAKKServerList",
   "plate": [
    "MPL_P_List"
   ],
   "ink": "light"
  },
  {
   "name": "status",
   "kind": "text",
   "plate": [
    "MPL_P_Status"
   ],
   "cvar": "dm_serverstatus",
   "ink": "light"
  },
  {
   "name": "add favourite",
   "kind": "action",
   "plate": [
    "MPL_P_AddFavourite"
   ],
   "lit": [
    "MPL_P_AddFavourite_Lit"
   ],
   "command": "widgetcommand netgamelist addfavorite"
  },
  {
   "name": "remove favourite",
   "kind": "action",
   "plate": [
    "MPL_P_RemoveFavourite"
   ],
   "lit": [
    "MPL_P_RemoveFavourite_Lit"
   ],
   "command": "widgetcommand netgamelist removefavorite"
  },
  {
   "name": "search",
   "kind": "field",
   "plate": [
    "MPL_P_Search"
   ],
   "cvar": "dm_browser_search",
   "ink": "light",
   "command": "widgetcommand netgamelist restartrefresh //"
  },
  {
   "name": "max ping",
   "kind": "list",
   "knob": [
    "MPL_Knob_F_PING"
   ],
   "plate": [
    "MPL_P_F_PING"
   ],
   "cvar": "dm_max_ping",
   "ink": "light",
   "items": [
    [
     "No limit",
     "set dm_max_ping 0;widgetcommand netgamelist restartrefresh"
    ],
    [
     "50",
     "set dm_max_ping 50;widgetcommand netgamelist restartrefresh"
    ],
    [
     "100",
     "set dm_max_ping 100;widgetcommand netgamelist restartrefresh"
    ],
    [
     "150",
     "set dm_max_ping 150;widgetcommand netgamelist restartrefresh"
    ],
    [
     "250",
     "set dm_max_ping 250;widgetcommand netgamelist restartrefresh"
    ],
    [
     "400",
     "set dm_max_ping 400;widgetcommand netgamelist restartrefresh"
    ]
   ]
  },
  {
   "name": "min players",
   "kind": "list",
   "knob": [
    "MPL_Knob_F_MINPLAYERS"
   ],
   "plate": [
    "MPL_P_F_MINPLAYERS"
   ],
   "cvar": "dm_min_players",
   "ink": "light",
   "items": [
    [
     "Any",
     "set dm_min_players 0;widgetcommand netgamelist restartrefresh"
    ],
    [
     "1",
     "set dm_min_players 1;widgetcommand netgamelist restartrefresh"
    ],
    [
     "4",
     "set dm_min_players 4;widgetcommand netgamelist restartrefresh"
    ],
    [
     "8",
     "set dm_min_players 8;widgetcommand netgamelist restartrefresh"
    ]
   ]
  },
  {
   "name": "max players",
   "kind": "list",
   "knob": [
    "MPL_Knob_F_MAXPLAYERS"
   ],
   "plate": [
    "MPL_P_F_MAXPLAYERS"
   ],
   "cvar": "dm_max_players",
   "ink": "light",
   "items": [
    [
     "No limit",
     "set dm_max_players 0;widgetcommand netgamelist restartrefresh"
    ],
    [
     "8",
     "set dm_max_players 8;widgetcommand netgamelist restartrefresh"
    ],
    [
     "16",
     "set dm_max_players 16;widgetcommand netgamelist restartrefresh"
    ],
    [
     "24",
     "set dm_max_players 24;widgetcommand netgamelist restartrefresh"
    ],
    [
     "32",
     "set dm_max_players 32;widgetcommand netgamelist restartrefresh"
    ]
   ]
